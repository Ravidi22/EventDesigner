# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is what README tells you to copy.
!.env.example

# agent skills: the packages themselves live in .agents/skills and ARE committed, so the guidance
# an agent follows is pinned with the code. What's ignored is how each tool reaches them —
# .claude/skills/<name> is an absolute symlink into this checkout, valid on one machine only.
# Recreate them with `npx skills experimental_install`.
/.claude/skills/supabase
/.claude/skills/supabase-postgres-best-practices

# vercel
.vercel

# impeccable hook cache
.impeccable/hook.cache.json

# graphify knowledge-graph output (regenerable, ~1.3MB)
/graphify-out/

# typescript
*.tsbuildinfo
next-env.d.ts

# local file storage: the stand-in for the R2 bucket (lib/files/driver-local.ts).
# A designer's photographs, not source — and they do not survive a deploy either way.
/.uploads/
