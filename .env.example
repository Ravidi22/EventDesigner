# Copy to .env.local and fill in. Nothing here is a real secret — the local values match
# docker-compose.yml, and the hosted ones are placeholders.
#
#   cp .env.example .env.local
#   docker compose up -d      # local Postgres (needs Docker Desktop)
#   npm run db:push           # apply lib/db/schema.ts

# ── Database ───────────────────────────────────────────────────────────────────────────────────
# Local development: matches the user/password/db in docker-compose.yml.
DATABASE_URL=postgresql://eve:eve@localhost:5432/eve

# Supabase (later): Project Settings → Database → Connection string.
# Use the POOLED connection (port 6543) from the app — a serverless function opens a connection per
# invocation and will exhaust a direct pool. Keep the DIRECT connection (port 5432) for migrations,
# which need a real session.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase (auth + file storage; not wired yet) ──────────────────────────────────────────────
# The anon key is public and ships to the browser. The service-role key bypasses RLS entirely —
# it is server-only, must never appear in a NEXT_PUBLIC_ variable, and must never be committed.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
